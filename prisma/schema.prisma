datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model MemberRegistration {
  id                String   @id @default(cuid())
  receiptNo         String   @unique
  date              String
  registrationFee   Int
  amountInWords     String
  address           String
  gaav              String?
  taluka            String?
  city              String?  @default("अमरावती")
  district          String?  @default("अमरावती")
  state             String?  @default("महाराष्ट्र")
  country           String?  @default("भारत")
  pincode           String?
  paymentMethod     String
  paymentScreenshot String?
  referredBy        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  mainMembers   MainMember[]
  familyMembers FamilyMember[]
}

model MainMember {
  id             String             @id @default(cuid())
  registrationId String
  srNo           Int
  memberNo       String
  fullName       String
  mobileNo       String
  prabhagNo      String
  registration   MemberRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}

model FamilyMember {
  id             String             @id @default(cuid())
  registrationId String
  srNo           Int
  name           String
  relation       String
  dob            String
  occupation     String
  mobile         String
  registration   MemberRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Donation {
  id                String   @id @default(cuid())
  receiptNo         String   @unique
  name              String
  mobileNo          String
  address           String?
  gaav              String?
  taluka            String?
  city              String?  @default("अमरावती")
  district          String?  @default("अमरावती")
  state             String?  @default("महाराष्ट्र")
  country           String?  @default("भारत")
  pincode           String?
  amount            Int
  amountInWords     String
  paymentScreenshot String?
  date              String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ExecutiveMember {
  id          String   @id @default(cuid())
  fullName    String
  designation String
  mobileNo    String
  address     String?
  gaav        String?
  taluka      String?
  city        String?  @default("अमरावती")
  district    String?  @default("अमरावती")
  state       String?  @default("महाराष्ट्र")
  country     String?  @default("भारत")
  pincode     String?
  photoUrl    String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CareerApplication {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String
  position   String
  message    String?
  city       String?
  district   String?
  resumeName String?
  resumeData String?  @db.Text
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  subject   String?
  message   String
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactInfo {
  id             String   @id @default("default")
  address        String
  phone          String
  alternatePhone String?
  email          String
  hours          String?
  updatedAt      DateTime @updatedAt
}

model Advertisement {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  imageUrl    String?  @db.Text
  videoUrl    String?  @db.Text
  mediaType   String?  @default("image")
  adLink      String?
  socialLinks String?  @db.Text
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ManagedUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String
  city      String?
  date      String?
  time      String?
  status    String   @default("VERIFIED")
  role      String   @default("User")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

